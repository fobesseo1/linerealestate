{
  "name": "sun-sanbon-realestate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3010",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "next start --hostname 0.0.0.0 --port 3010",
    "typecheck": "tsc --noEmit",
    "maps:prepare": "node scripts/prepare-map-positions.mjs",
    "test": "npm run test:guard && npm run typecheck && npm run test:unit",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.mjs",
    "test:step1": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/step1-code.mjs",
    "test:guard": "node scripts/qa/guard-check.mjs",
    "check:site": "node scripts/qa/site-check.mjs",
    "check:standalone": "node scripts/qa/standalone-check.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "test:step5": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/step5-seo.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@supabase/supabase-js": "2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "nodemailer": "10.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
